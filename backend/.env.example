# Copy this file to .env (or export the variable in your shell) and fill in
# your real Neon PostgreSQL connection string. Never commit the real .env file.
#
# Get this value from the Neon console: Project -> Connect -> Connection string.
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://username:password@ep-example-12345.region.aws.neon.tech/campus_lost_found?sslmode=require
